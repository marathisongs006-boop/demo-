rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for authorized admin UIDs
    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.uid == "n66vwcTu3OZVvPvqTOAmjSq8xSz1" ||
        request.auth.uid == "gVWdJNbS5WVqcUqYc2KC4P0HrR32"
      );
    }

    // Public portfolio collections: Anyone can read, only authorized admin UID can write/delete
    match /profile/{docId} {
      allow read: if true;
      allow write, delete: if isAuthorizedAdmin();
    }

    match /skills/{docId} {
      allow read: if true;
      allow write, delete: if isAuthorizedAdmin();
    }

    match /projects/{docId} {
      allow read: if true;
      allow write, delete: if isAuthorizedAdmin();
    }

    match /experience/{docId} {
      allow read: if true;
      allow write, delete: if isAuthorizedAdmin();
    }

    match /services/{docId} {
      allow read: if true;
      allow write, delete: if isAuthorizedAdmin();
    }

    match /socialLinks/{docId} {
      allow read: if true;
      allow write, delete: if isAuthorizedAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write, delete: if isAuthorizedAdmin();
    }

    // Contact messages: Public visitors can submit (create), only authorized admin UID can read/update/delete
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string 
                    && request.resource.data.message is string;
      allow read, update, delete: if isAuthorizedAdmin();
    }
  }
}
